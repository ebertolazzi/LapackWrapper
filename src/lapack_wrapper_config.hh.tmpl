///
/// file: lapack_wrapper_config.hh
///

#pragma once

#ifndef LAPACK_WRAPPER_CONFIG_dot_HH
#define LAPACK_WRAPPER_CONFIG_dot_HH

/*\
 ! values
 !  LAPACK_WRAPPER_USE_ACCELERATE, LAPACK_WRAPPER_USE_ATLAS, LAPACK_WRAPPER_USE_OPENBLAS,
 !  LAPACK_WRAPPER_USE_LAPACK, LAPACK_WRAPPER_USE_MKL, LAPACK_WRAPPER_USE_BLASFEO
\*/
@@LAPACK_WRAPPER_USE@@

/*\
 ! define
 ! LAPACK_WRAPPER_DO_NOT_USE_SYSTEM_OPENBLAS
 ! if you want to use locally compiled openblas
\*/
@@LAPACK_WRAPPER_NOSYSTEM_OPENBLAS@@

/*
 * On macOS, force Apple system headers used by Accelerate/vecLib to be
 * parsed at global namespace scope before any Utils header is included.
 * This prevents guarded system typedefs such as filesec_t from being first
 * declared as Utils::filesec_t if a transitive Utils header opens namespace
 * Utils around system includes.
 */
#if defined(__APPLE__)
  #include <fcntl.h>
#endif

#ifdef NO_SYSTEM_UTILS
  #include "Utils.hh"
  #include "Utils_fmt.hh"
  #include "Utils_trace.hh"
  #include "Utils_TicToc.hh"
#else
  #include <Utils.hh>
  #include <Utils_fmt.hh>
  #include <Utils_trace.hh>
  #include <Utils_TicToc.hh>
#endif

#include <format>

namespace lapack_wrapper {
  using Utils::ostream_type;
  using Utils::Malloc;

  inline void
  lw_assert( bool cond, std::string_view msg ) {
    if ( !cond ) throw std::runtime_error( std::string(msg) );
  }
  
  template <typename... Args> requires ( sizeof...(Args) > 0 )
  inline void
  lw_assert( bool cond, std::format_string<Args...> fmt, Args &&... args ) {
    if ( !cond ) throw std::runtime_error( std::format( fmt, std::forward<Args>(args)... ) );
  }

}

#endif

///
/// eof: lapack_wrapper_config.hh
///
